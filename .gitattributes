# 文本文件默认使用CRLF行尾
* text=auto eol=crlf

# 特定文件类型的行尾设置
*.js text eol=crlf
*.html text eol=crlf
*.css text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.txt text eol=crlf
*.csv text eol=crlf
*.xml text eol=crlf
*.yaml text eol=crlf
*.yml text eol=crlf

# 二进制文件保持原样
